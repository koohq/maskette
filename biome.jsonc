{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/src-tauri/target", "!**/src-tauri/gen", "!**/frontend/public"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  // index.css uses Tailwind 4 at-rules (@import "tailwindcss", @theme, @custom-variant).
  "css": { "parser": { "tailwindDirectives": true } },
  // The docs are Japanese prose that several sessions edit by hand; padding every table
  // cell to the widest one turns each one-word edit into a whole-table diff.
  "markdown": { "formatter": { "enabled": false } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // The frontend uses @tsconfig/strictest, whose noPropertyAccessFromIndexSignature
        // requires `record["key"]` for index signatures; this rule asks for the opposite.
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // These stylesheets restyle MUI components, whose own styles come from emotion
      // with higher specificity; !important is how they win.
      "includes": ["frontend/src/styles/**"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    },
    {
      // In tests a non-null assertion is the check: a missing element fails the test at once.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
