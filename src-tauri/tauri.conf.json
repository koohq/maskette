{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Maskette",
  "version": "0.1.0",
  "identifier": "app.maskette",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter ./frontend dev",
    "beforeBuildCommand": "pnpm --filter ./frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maskette",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
