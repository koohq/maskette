{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Maskette",
  "version": "0.1.2",
  "identifier": "app.maskette",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter ./frontend dev",
    "beforeBuildCommand": "pnpm --filter ./frontend build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NTQ1MUQ3QzYwNTFCRTkKUldUcEd3WEcxMUZVMUplTURURVh4MzJFbXJqd05YYVRyZ0F1dC9kakdGRktYbmlYWi9sUHBEWDgK",
      "endpoints": ["https://github.com/koohq/maskette/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Maskette contributors",
    "copyright": "Copyright (C) 2026 Maskette contributors. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "GraphicsAndDesign",
    "shortDescription": "A design tool for kigurumi masks",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": ["English", "Japanese", "SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
