{
  "name": "maskette-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "vrt": "playwright test",
    "vrt:update": "playwright test --update-snapshots",
    "screenshots": "node vrt/readme-screenshots.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p vrt/tsconfig.json",
    "deps:semver": "pnpm up -r",
    "deps:latest": "pnpm up -r --latest",
    "deps:interactive": "pnpm up -r -i --latest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@mui/material": "^9.6.0",
    "@tabler/icons-react": "^3.53.0",
    "@tanstack/react-query": "5.108.4",
    "i18next": "^27.2.7",
    "onnxruntime-web": "^1.31.1",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "7.18.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^31.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
