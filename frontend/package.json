{
  "name": "maskette-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "vrt": "playwright test",
    "vrt:update": "playwright test --update-snapshots",
    "screenshots": "node vrt/readme-screenshots.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p vrt/tsconfig.json",
    "deps:semver": "pnpm up -r",
    "deps:latest": "pnpm up -r --latest",
    "deps:interactive": "pnpm up -r -i --latest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "5.105.1",
    "i18next": "^26.6.0",
    "konva": "^10.9.1",
    "motion": "^14.9.0",
    "onnxruntime-web": "^1.31.1",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.10",
    "react-konva": "^19.3.2",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "^30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
