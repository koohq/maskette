{
  "$schema": "https://www.schemastore.org/tsconfig",
  // Type-checks the tests, which tsconfig.json leaves out so the app build never sees them.
  // Only the tests get Node's types (node:fs, import.meta.dirname); the app runs in the webview.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": []
}
